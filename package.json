{
  "name": "gloomydate",
  "version": "2.0.0",
  "description": "A library for calculating relative time strings, compatible with both ESM and MPA environments.",
  "type": "module",
  "main": "dist/gloomyDate.cjs",
  "module": "dist/gloomyDate.js",
  "exports": {
    ".": {
      "import": "./dist/gloomyDate.js",
      "require": "./dist/gloomyDate.cjs"
    }
  },
  "files": [
    "dist/gloomyDate.js",
    "dist/gloomyDate.cjs",
    "dist/gloomyDate.d.ts",
    "LICENSE",
    "README.md",
    "index.d.ts",
    "index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gloomystore/gloomyDate.git"
  },
  "homepage": "https://github.com/gloomystore/gloomyDate#readme",
  "license": "Apache-2.0",
  "keywords": [
    "date",
    "datetime",
    "relative-time",
    "gloomydate",
    "time-ago",
    "javascript",
    "date-time",
    "ESM",
    "CJS",
    "MPA",
    "time-calculation",
    "time-difference",
    "date-time-difference",
    "date-difference",
    "time-formatter",
    "relative-time-calculator",
    "elapsed-time",
    "time-since",
    "ago-calculator",
    "date-utility",
    "시간 계산",
    "날짜 계산",
    "리액트 날짜 계산",
    "뷰 시간 계산",
    "게시판 날짜",
    "게시판 날짜 계산",
    "time-until",
    "time-until-calculator",
    "future-time-calculator",
    "after-calculation",
    "before-calculation",
    "date-in-future",
    "date-in-past"
  ],
  "author": "GloomyStore",
  "copyright": "Copyright © 2024 GloomyStore",
  "browserslist": {
    "production": [
      "last 5 Chrome versions",
      "last 5 Firefox versions",
      "last 5 Safari versions",
      "last 5 Edge versions"
    ],
    "development": [
      "last 5 Chrome versions",
      "last 5 Firefox versions",
      "last 5 Safari versions",
      "last 5 Edge versions"
    ]
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "env": {
      "browser": true,
      "node": true
    }
  },
  "scripts": {
    "build": "tsup gloomyDate.ts --format cjs,esm --dts"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  }
}
